{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgoraExam",
  "version": "0.1.0",
  "identifier": "com.agoraexam.lockdown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgoraExam - Session d'Examen Sécurisée",
        "width": 1280,
        "height": 800,
        "fullscreen": true,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "center": true,
        "focus": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: wss: ws:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "entitlements": null,
      "infoPlist": "Info.plist"
    }
  }
}
